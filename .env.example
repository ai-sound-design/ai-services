# Copy to .env and adjust. Every value has a working default, so an empty .env
# is fine for a local test run.

# ── Ports on the host ────────────────────────────────────────────────────────
# The plugin's default adapter profiles expect these.
MMAUDIO_PORT=8000
SOUND_SEARCH_PORT=8002
SPOTTING_PORT=8003
HYBRID_PORT=8004
POSTGRES_PORT=5432
# The containerised Ollama; 11435 so it does not collide with a host install.
OLLAMA_PORT=11435

# ── Generation ───────────────────────────────────────────────────────────────
# auto | cuda        — auto picks the GPU. (cpu is accepted by the code but takes
#                      minutes per second of audio; the stack needs an NVIDIA GPU.)
FORCE_DEVICE=auto
# bfloat16 | float16 | float32
FORCE_DTYPE=bfloat16
# Which MMAudio variant to serve. The chosen one is fetched at container start.
MMAUDIO_MODEL=large_44k_v2
# 1 = fetch the model before the server accepts requests, so a generation run
# never fails halfway through on a download. Set to 0 only to debug a start-up
# problem; the model is then fetched on the first request instead.
MMAUDIO_PREFETCH=1
# In-memory video cache. Keep well below your system RAM.
VIDEO_CACHE_MAX_GB=8
VIDEO_CACHE_TTL_MIN=60

# ── Sound search ─────────────────────────────────────────────────────────────
# on_demand  = a sound is fetched from its media URL the first time it is
#              previewed or imported, so the BBC archive is searchable without
#              downloading it (default).
# local_only = only sounds already on disk appear in results; for a machine
#              without internet access, after sources/bbc/download.py has run.
AUDIO_FETCH=on_demand
# Where fetched and downloaded audio is stored, one subfolder per library.
# Relative paths are resolved next to this file; point it at another drive if
# space is tight.
AUDIO_HOST_DIR=./data/audio
# Your own sound libraries: one subfolder per library, mounted read-only.
#   ./data/libraries/mine/**/*.wav  ->  docker compose run --rm indexer python index_folder.py mine
LIBRARIES_HOST_DIR=./data/libraries
# mp3 (~10 GB for the full BBC archive) or wav (much larger), for download.py
BBC_AUDIO_FORMAT=mp3
# Audio encoder for the search by sound (embed_audio.py and the API must agree).
CLAP_MODEL=laion/clap-htsat-fused

# ── Database ─────────────────────────────────────────────────────────────────
# Only read on the first start (the values are baked into the data volume).
POSTGRES_DB=sounds
POSTGRES_USER=sound_user
POSTGRES_PASSWORD=change_me

# ── Spotting (vision-language model) ─────────────────────────────────────────
# 1 = run Ollama inside this stack (default; the model is pulled on first start).
# 0 = an Ollama or another OpenAI-compatible server already runs on this
#     machine: leave the container out and point VLM_URL at it.
BUNDLED_OLLAMA=1
# Where the model runs. Default: the ollama container from docker-compose.yml.
# For an Ollama on the host: http://host.docker.internal:11434 (and start that
# Ollama with OLLAMA_HOST=0.0.0.0). For LM Studio, vLLM etc.: VLM_API=openai,
# e.g. VLM_URL=http://host.docker.internal:1234.
VLM_URL=http://ollama:11434
VLM_API=ollama
# Must be a variant with a vision projector; plain gemma4:e4b silently ignores images.
VLM_MODEL=gemma4:e4b-it-qat
# Reuse an existing Ollama model store instead of downloading again, e.g.
#   OLLAMA_MODELS_HOST_DIR=C:/Users/you/.ollama
OLLAMA_MODELS_HOST_DIR=./data/ollama
# Frames sampled per second of video, and frames shown to the model per call.
SPOTTING_SAMPLE_FPS=2
SPOTTING_FRAMES_PER_CALL=8
# Model context; 8192 is too small for eight frames with Gemma 4.
VLM_NUM_CTX=32768
# Burn each frame's time into its corner (1) so the model can place events in time.
FRAME_STAMP=1
# Sampling temperature; 0 keeps repeated runs as alike as the model allows.
VLM_TEMPERATURE=0
# How long Ollama keeps the model in VRAM after the last request. A cold load
# takes minutes; -1 keeps it forever (about 3 GB of VRAM).
OLLAMA_KEEP_ALIVE=1h

# ── Hybrid (one sound per event) ─────────────────────────────────────────────
# The generation model's length window: shorter events are padded then trimmed,
# longer ones get a sound of the maximum length.
HYBRID_GEN_MIN_SECONDS=4
HYBRID_GEN_MAX_SECONDS=12

# ── Diagnostics ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_TRACEMALLOC=false
