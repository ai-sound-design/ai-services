# Copy to .env and adjust. Every value has a working default, so an empty .env
# is fine for a local test run.

# ── Ports on the host ────────────────────────────────────────────────────────
# The plugin's default adapter profiles expect these.
MMAUDIO_PORT=8000
SOUND_SEARCH_PORT=8002
SPOTTING_PORT=8003
HYBRID_PORT=8004
SETUP_PORT=8020
POSTGRES_PORT=5432
# The containerised Ollama (on a Mac: the one install_mac.sh runs); 11435 so it
# does not collide with a host install.
OLLAMA_PORT=11435
# Mac only (install_mac.sh): the address the services listen on. 127.0.0.1 keeps
# them to this Mac; 0.0.0.0 makes them reachable from the network, as Docker does.
# MAC_BIND_HOST=127.0.0.1
# Mac only: the web UI install_mac.sh sets up (github.com/ai-sound-design/ai-sound-webui).
# WEBUI_SESSIONS_DIRS: folders with Pro Tools sessions it shows (";" between several;
# not in Documents/Desktop/Downloads). MAC_WEBUI=0 leaves the web UI out.
# WEBUI_PORT=8030
# WEBUI_SESSIONS_DIRS=
# MAC_WEBUI=1

# ── Generation ───────────────────────────────────────────────────────────────
# auto | cuda | mps  — auto picks the GPU: CUDA with Docker, the Apple GPU (mps) on
#                      a Mac. (cpu is accepted by the code but takes minutes per
#                      second of audio.)
FORCE_DEVICE=auto
# bfloat16 | float16 | float32 (install_mac.sh sets float32: the M1/M2 GPU has no
# native bfloat16)
FORCE_DTYPE=bfloat16
# Which MMAudio variant to serve. The chosen one is fetched at container start.
MMAUDIO_MODEL=large_44k_v2
# 1 = fetch the model before the server accepts requests, so a generation run
# never fails halfway through on a download. Set to 0 only to debug a start-up
# problem; the model is then fetched on the first request instead.
MMAUDIO_PREFETCH=1
# In-memory video cache. Keep well below your system RAM.
VIDEO_CACHE_MAX_GB=8
VIDEO_CACHE_TTL_MIN=60

# ── Sound search ─────────────────────────────────────────────────────────────
# on_demand  = a sound is fetched from its media URL the first time it is
#              previewed or imported, so the BBC archive is searchable without
#              downloading it (default).
# local_only = only sounds already on disk appear in results; for a machine
#              without internet access, after sources/bbc/download.py has run.
AUDIO_FETCH=on_demand
# Where fetched and downloaded audio is stored, one subfolder per library.
# Relative paths are resolved next to this file; point it at another drive if
# space is tight.
AUDIO_HOST_DIR=./data/audio
# Your own sound libraries: one subfolder per library, mounted read-only.
#   ./data/libraries/mine/**/*.wav  ->  docker compose run --rm indexer python index_folder.py mine
LIBRARIES_HOST_DIR=./data/libraries
# An existing copy of the BBC archive (folder with <id>.wav or .mp3 files), read-only;
# install.ps1 asks for it. Empty: the archive is fetched on demand or downloaded.
BBC_ARCHIVE_HOST_DIR=./data/archive
# A folder of your own sounds, read-only, indexed as the library OWN_SOUNDS_NAME
OWN_SOUNDS_HOST_DIR=./data/own-sounds
OWN_SOUNDS_NAME=own
# mp3 (~10 GB for the full BBC archive) or wav (much larger), for download.py
BBC_AUDIO_FORMAT=mp3
# Audio encoder for the search by sound (embed_audio.py and the API must agree).
CLAP_MODEL=laion/clap-htsat-fused

# ── Database ─────────────────────────────────────────────────────────────────
# Only read on the first start (the values are baked into the data volume).
POSTGRES_DB=sounds
POSTGRES_USER=sound_user
POSTGRES_PASSWORD=change_me

# ── Spotting (vision-language model) ─────────────────────────────────────────
# 1 = run Ollama inside this stack (default; the model is pulled on first start).
# 0 = an Ollama or another OpenAI-compatible server already runs on this
#     machine: leave the container out and point VLM_URL at it.
BUNDLED_OLLAMA=1
# Where the model runs. Default: the ollama container from docker-compose.yml.
# For an Ollama on the host: http://host.docker.internal:11434 (and start that
# Ollama with OLLAMA_HOST=0.0.0.0). For LM Studio, vLLM etc.: VLM_API=openai,
# e.g. VLM_URL=http://host.docker.internal:1234. For OpenAI itself (no local
# model, no GPU for the spotting; the frames leave the machine): VLM_API=openai,
# VLM_URL=https://api.openai.com, VLM_MODEL=<a vision model>, and the key below.
VLM_URL=http://ollama:11434
VLM_API=ollama
# Bearer token for a hosted OpenAI-compatible service; empty for a local server.
VLM_API_KEY=
# Must be a variant with a vision projector; plain gemma4:e4b silently ignores images.
VLM_MODEL=gemma4:e4b-it-qat
# Where the models live. Empty: Docker volumes ("models" for MMAudio's weights and
# the search models, "ollama-models" for the vision-language model), inside Docker's
# own disk, where a 6 GB model loads in seconds; Docker Desktop lists them under
# Volumes. A folder instead (MODELS_STORE=D:/AI Sound Design/models) keeps them
# visible as files but loads them through Docker Desktop's file sharing, in
# minutes. For the vision-language model a folder can also be an existing Ollama
# store, e.g. OLLAMA_MODELS_STORE=C:/Users/you/.ollama, so nothing is downloaded
# twice. install.ps1 moves existing models between a folder and the volumes.
MODELS_STORE=
OLLAMA_MODELS_STORE=
# Frames sampled per second of video, and frames shown to the model per call.
SPOTTING_SAMPLE_FPS=2
SPOTTING_FRAMES_PER_CALL=8
# Picture cuts inside a clip: foley and sound-effect events are split there, one per
# shot (ambience carries on). 0 turns it off; the threshold is the hash distance
# between consecutive frames that counts as a cut (camera moves stay below 0.25).
SPOTTING_CUT_DETECTION=1
SPOTTING_CUT_THRESHOLD=0.3
SPOTTING_CUT_MIN_PIECE_S=0.3
# A sparse first pass describes the scenes (place, what the people do, expected
# sounds, the ambience); the dense pass then spots each chunk knowing its scene.
# 0 turns it off. SCENE_FPS: frames sampled per second for that pass.
SPOTTING_SCENE_CONTEXT=1
SPOTTING_SCENE_FPS=0.25
# 1: each chunk call is also told which sounds the scene pass expects; finds more
# (keyboard, whooshes) but a small model then invents some of them in every chunk.
SPOTTING_SCENE_CHECKLIST=0
SPOTTING_EVENT_EVIDENCE=0
# 1: the model writes per-frame observations before the events (fewer invented ones
# with a checklist, fewer found without).
SPOTTING_EVENT_OBSERVE=0
# What a chunk call is told about its scene: place (the place only), full (also what
# happens; a small model then lists those actions in every chunk), none.
SPOTTING_SCENE_HINT=place
# A scene shorter than this (seconds) is a shot and joins its neighbour.
SPOTTING_MIN_SCENE_S=10
# Same-label events closer than this (seconds) are one event, like one clip of steps.
SPOTTING_MERGE_GAP_S=2.0
# Longest answer of one model call in tokens; a runaway generation is cut off here
# and the call retried once, then skipped, instead of stalling the whole run.
SPOTTING_VLM_NUM_PREDICT=2048
# Model context; 8192 is too small for eight frames with Gemma 4.
VLM_NUM_CTX=32768
# Burn each frame's time into its corner (1) so the model can place events in time.
FRAME_STAMP=1
# Sampling temperature; 0 keeps repeated runs as alike as the model allows.
VLM_TEMPERATURE=0
# How long Ollama keeps the model in VRAM after the last request. A cold load
# takes minutes; -1 keeps it forever (about 3 GB of VRAM).
OLLAMA_KEEP_ALIVE=1h

# ── Hybrid (one sound per event) ─────────────────────────────────────────────
# The generation model's length window: shorter events are padded then trimmed,
# longer ones get a sound of the maximum length.
HYBRID_GEN_MIN_SECONDS=4
HYBRID_GEN_MAX_SECONDS=12

# ── Diagnostics ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_TRACEMALLOC=false

# Library matches in the hybrid mode: the description search proposes this many
# recordings for an event's words, the search by sound then picks the best stretch
# among them. 0: the search by sound alone (CLAP hears rain in a roaring fire).
HYBRID_CANDIDATES_BY_TEXT=20
